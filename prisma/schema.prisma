// ======================================================
// 🔧 Configurações do Prisma
// ======================================================
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// 📌 ENUMS
// ======================================================
enum Roles {
  ADMIN
  CLIENT
  SUPPLIER
}

enum OrderStatus {
  WAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

// ======================================================
// 🧑‍💼 User — Usuários
// ======================================================
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  password  String
  phone     String
  birthDate DateTime? @map("birth_date")
  image     String?

  role Roles @default(CLIENT)

  properties Property[]
  orders     Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user")
}

// ======================================================
// 📍 Location — Endereços
// ======================================================
model Location {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  street  String
  city    String
  state   String
  zipcode String

  properties Property[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("location")
}

// ======================================================
// 💰 Rate — Tarifas
// ======================================================
model Rate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  weekly  Float?
  monthly Float?
  nightly Float?

  properties Property[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("rate")
}

// ======================================================
// 🧺 Amenity — Amenidades
// ======================================================
model Amenity {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  amenities PropertyAmenity[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("amenity")
}

// ======================================================
// 🔗 PropertyAmenity — Pivot N:N
// ======================================================
model PropertyAmenity {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  amenityId String  @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([propertyId, amenityId])
  @@map("property_amenity")
}

// ======================================================
// 🏡 Property — Imóvel
// ======================================================
model Property {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String
  type        String
  description String

  beds       Int
  baths      Int
  squareFeet Int     @map("square_feet")
  isFeatured Boolean @default(false) @map("is_featured")

  rateId String @db.Uuid
  rate   Rate   @relation(fields: [rateId], references: [id])

  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  amenities PropertyAmenity[]
  images    ImageProperty[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("property")
}

// ======================================================
// 🔗 Pivot — Property ↔ Image
// ======================================================
model ImageProperty {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  imageId String @db.Uuid
  image   Image  @relation(fields: [imageId], references: [id])

  @@id([propertyId, imageId])
  @@map("property_image")
}

// ======================================================
// 🛒 Product — Produtos
// ======================================================
model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String
  description String
  price       Float?

  orderItems OrderItem[]
  categories ProductCategory[]

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime?      @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")
  images    ImageProduct[]

  @@map("product")
}

// ======================================================
// 🔗 Pivot — Product ↔ Image
// ======================================================
model Image {
  id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url String @db.Text

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime?       @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  products        ImageProduct[]
  imageCategories CategoryImage[]
  imageProperties ImageProperty[]

  // Nome único da tabela
  @@map("image")
}

model ImageProduct {
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  imageId String @db.Uuid
  image   Image  @relation(fields: [imageId], references: [id])

  @@id([productId, imageId])
  @@map("product_image")
}

// ======================================================
// 🏷️ Category
// ======================================================
model Category {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?

  // Relação 1:1 → Uma categoria tem 1 imagem

  products ProductCategory[]

  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime?       @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")
  images    CategoryImage[]

  @@map("category")
}

model CategoryImage {
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  imageId String @db.Uuid
  image   Image  @relation(fields: [imageId], references: [id])

  @@id([categoryId, imageId])
  @@map("category_image")
}

// ======================================================
// 🔗 Pivot — Category ↔ Product
// ======================================================
model ProductCategory {
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("product_category")
}

// ======================================================
// 🧾 Order — Pedido
// ======================================================
model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  status  OrderStatus @default(WAITING_PAYMENT)
  payment Payment?

  clientId String @map("client_id") @db.Uuid
  client   User   @relation(fields: [clientId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("order")
}

// ======================================================
// 💳 Payment — Pagamento
// ======================================================
model Payment {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status String

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("payment")
}

// ======================================================
// 📦 OrderItem — Item de pedido
// ======================================================
model OrderItem {
  quantity Int
  price    Float

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@id([productId, orderId])
  @@map("order_item")
}
