// ======================================================
// 🔧 Configurações principais do Prisma
// ======================================================
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// 🧑‍💼 User — Usuários da aplicação (1:N com Property)
// ======================================================
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Dados pessoais
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String  @unique
  password  String
  phone     String
  image     String?

  // Regra de acesso
  role Int @default(1)

  // Relacionamentos
  properties Property[]

  // Auditoria
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user")
}

// ======================================================
// 📍 Location — Dados de endereço (1:N com Property)
// ======================================================
model Location {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  street  String
  city    String
  state   String
  zipcode String

  // Relacionamentos
  properties Property[]

  // Auditoria
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("location")
}

// ======================================================
// 💰 Rate — Tarifas (1:N com Property)
// ======================================================
model Rate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  weekly  Float?
  monthly Float?
  nightly Float?

  properties Property[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("rate")
}

// ======================================================
// 🧺 Amenity — Amenidades (N:N via PropertyAmenity)
// ======================================================
model Amenity {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  // Relacionamento N:N
  propertyAmenities PropertyAmenity[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("amenity")
}

// ======================================================
// 🔗 Tabela de junção N:N explícita
// ======================================================
model PropertyAmenity {
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  amenityId String  @map("amenity_id") @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([propertyId, amenityId])
  @@map("property_amenity")
}

// ======================================================
// 🖼️ Image — Imagens de um imóvel (1:N)
// ======================================================
model Image {
  id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url String @db.Text

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("image")
}

// ======================================================
// 🏡 Property — Imóvel (relaciona tudo)
// ======================================================
model Property {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Dados gerais
  name        String
  type        String
  description String

  // Características físicas
  beds       Int
  baths      Int
  squareFeet Int     @map("square_feet")
  isFeatured Boolean @default(false) @map("is_featured")

  // Relacionamentos
  rateId String @map("rate_id") @db.Uuid
  rate   Rate   @relation(fields: [rateId], references: [id])

  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  images    Image[]
  amenities PropertyAmenity[]

  // Auditoria
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("property")
}
